# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets.

# --- Razorpay (optional) ---
# Leave these blank to launch with COD + WhatsApp ordering only.
# Get real keys from https://dashboard.razorpay.com/app/keys after
# creating/activating your Razorpay merchant account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match RAZORPAY_KEY_ID above — this one is exposed to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
